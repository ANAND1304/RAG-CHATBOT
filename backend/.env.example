# ============================================================
# RAG Chatbot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# App Settings
APP_NAME="RAG Chatbot"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ─── LLM Backend ─────────────────────────────────────────────
# Option A: Use Anthropic API (recommended for quick start)
use_anthropic_api=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option B: Use local HuggingFace model (requires ~14GB RAM / GPU)
# USE_ANTHROPIC_API=false
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# USE_4BIT=true    # Enable 4-bit quantization (requires GPU + bitsandbytes)

# ─── Embeddings ──────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── RAG Parameters ──────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.3

# ─── HuggingFace (optional, for gated models) ────────────────
# HUGGINGFACE_HUB_TOKEN=your_hf_token_here
